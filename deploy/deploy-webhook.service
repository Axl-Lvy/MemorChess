[Unit]
Description=MemorChess deploy webhook
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/memorchess/deploy
# Check `webhook --help` for the installed version's exact flags before relying on these.
ExecStart=/usr/local/bin/webhook -hooks webhook-hooks.yaml -port 9000 -verbose
Restart=on-failure
# Must be a user in the docker group, so deploy.sh's `docker compose` calls work without sudo.
User=memorchess

[Install]
WantedBy=multi-user.target

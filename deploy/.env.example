# --- Server / Postgres ---
# postgres:5432 resolves via the Compose network; POSTGRES_DB is fixed to "memorchess" in
# docker-compose.yml, so this URL's path must match.
SYNC_DB_URL=jdbc:postgresql://postgres:5432/memorchess
SYNC_DB_USER=memorchess
SYNC_DB_PASSWORD=

# From the Logto tenant (a2qj1s) set up for client OIDC auth.
SYNC_JWT_ISSUER=https://a2qj1s.logto.app/oidc
SYNC_JWT_AUDIENCE=https://api.memorchess.app
SYNC_JWKS_URL=https://a2qj1s.logto.app/oidc/jwks

# Repertoire blob storage (Cloudflare R2) — from the earlier repertoire-storage setup, not created
# by this deployment.
SYNC_R2_ENDPOINT=
SYNC_R2_BUCKET=
SYNC_R2_ACCESS_KEY_ID=
SYNC_R2_SECRET_ACCESS_KEY=

# Shared secret gating the /admin/* routes (see ServerConfig.kt's KDoc).
SYNC_ADMIN_TOKEN=

# --- Cloudflare Tunnel ---
# From `cloudflared tunnel token <tunnel-name>` after creating the tunnel and its two ingress
# rules (memorchess.axl-lvy.fr -> server:8080, deploy.memorchess.axl-lvy.fr -> the webhook).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Deploy webhook ---
# Must match the literal value baked into webhook-hooks.yaml (see webhook-hooks.yaml.example) and
# the DEPLOY_WEBHOOK_TOKEN GitHub Actions secret.
DEPLOY_WEBHOOK_TOKEN=
